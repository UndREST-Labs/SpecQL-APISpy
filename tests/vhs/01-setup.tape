# VHS tape for demonstrating the SpeQL setup process
# This demo shows how to set up SpeQL including installing dependencies

Output demos/01-setup.gif

Set Shell bash
Set FontSize 16
Set Width 1000
Set Height 720
Set Theme "TokyoNight"
Set TypingSpeed 80ms
Set WindowBar ColorfulRight

Type "# SpeQL Setup Demo - Installation Steps"
Enter
Sleep 1s

Type "# Step 1: Clone the repository"
Enter
Type "git clone https://github.com/SpeQLSec/SpeQL.git"
Enter
Sleep 1s

Type "# Step 2: Navigate to directory"
Enter
Type "cd SpeQL"
Enter
Sleep 1s

Type "# Step 3: Install Python dependencies"
Enter
Type "pip3 install -r requirements.txt"
Enter
Sleep 1s

Type "# Step 4: Run automated setup script"
Enter
Type "./setup.sh"
Enter
Sleep 2s
