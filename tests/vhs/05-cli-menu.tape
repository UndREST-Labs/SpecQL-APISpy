# VHS tape for demonstrating the interactive CLI menu
# This demo shows how to navigate and use the SpeQL CLI

Output demos/05-cli-menu.gif

Set Shell bash
Set FontSize 13
Set Width 1000
Set Height 600
Set Theme "Catppuccin Mocha"
Set TypingSpeed 100ms

Type "# ╔═══════════════════════════════════════════════════════╗"
Enter
Type "# ║  SpeQL Interactive CLI Menu Demo                     ║"
Enter
Type "# ╚═══════════════════════════════════════════════════════╝"
Enter
Sleep 1s
Enter

Type "# Launch the interactive CLI"
Enter
Type "python3 SpeQL.py"
Enter
Sleep 1s
Enter

Type "#    _____            ____    __  "
Enter
Type "#   / ___/____  ___  / __ \\  / /  "
Enter
Type "#   \\__ \\/ __ \\/ _ \\/ / / / / /   "
Enter
Type "#  ___/ / /_/ /  __/ /_/ / / /___  "
Enter
Type "# /____/ .___/\\___/\\___\\_\\/_____/  "
Enter
Type "#     /_/                          "
Enter
Sleep 1s
Enter

Type "# Main Menu"
Enter
Type "# ────────────────────────────────"
Enter
Type "# 1. 📊 Security Analysis"
Enter
Type "# 2. 🗄️  Database Management"
Enter
Type "# 3. 🔍 CodeQL Security Queries"
Enter
Type "# 4. 📈 SARIF Analysis Tools"
Enter
Type "# 5. ⚙️  Setup and Installation"
Enter
Type "# 6. 📚 Documentation and Help"
Enter
Type "# 0. Exit"
Enter
Sleep 3s
